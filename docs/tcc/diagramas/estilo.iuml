!pragma layout smetana
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #3A3A3A
skinparam ArrowThickness 1.2
skinparam ClassBackgroundColor #F5F8FD
skinparam ClassBorderColor #2A78D6
skinparam ClassHeaderBackgroundColor #E3EDFA
skinparam UsecaseBackgroundColor #F5F8FD
skinparam UsecaseBorderColor #2A78D6
skinparam ActorBorderColor #3A3A3A
skinparam ComponentBackgroundColor #F5F8FD
skinparam ComponentBorderColor #2A78D6
skinparam PackageBorderColor #8A8A8A
skinparam NoteBackgroundColor #FFF8E6
skinparam NoteBorderColor #C98500
skinparam SequenceLifeLineBorderColor #8A8A8A
skinparam ParticipantBackgroundColor #F5F8FD
skinparam ParticipantBorderColor #2A78D6
skinparam DatabaseBackgroundColor #F5F8FD
skinparam DatabaseBorderColor #2A78D6
